# =====================================================================
# Plantilla de variables de entorno para el deploy en servidor Metaprotec
# Copiar a `.env.production` (en la raíz del repo) y rellenar
# =====================================================================

# --- Dominio público ----------------------------------------------------
# Origen exacto con el que el navegador carga la app. SIN slash final.
# Ejemplo: https://prensa.metaprotec.com
APP_BASE_URL=https://CAMBIAR.metaprotec.com

# --- Base de datos ------------------------------------------------------
POSTGRES_DB=metapress
POSTGRES_USER=metapress
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# --- Seguridad / auth ---------------------------------------------------
# Ambos deben tener mínimo 32 caracteres
AUTH_TOKEN_SECRET=CAMBIAR_minimo_32_caracteres_aleatorios________
TOTP_ENCRYPTION_KEY=CAMBIAR_minimo_32_caracteres_aleatorios________

# Días que dura la cookie de sesión (1-30)
SESSION_COOKIE_MAX_AGE_DAYS=7

# Expiración (minutos) del token de reset de contraseña
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# --- SMTP (correo de salida real) ---------------------------------------
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=usuario@dominio.com
SMTP_PASS=password_smtp
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_FROM=noreply@tu-dominio.com

# --- Integraciones externas --------------------------------------------
SEARCH_API_KEY=
SEARCH_API_URL=https://www.searchapi.io/api/v1/search

# --- Cron / jobs internos (opcional) -----------------------------------
CRON_SECRET=CAMBIAR_minimo_16_caracteres_____
