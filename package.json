{
  "name": "prensa-app-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "corepack pnpm --parallel --stream --filter @prensa-app/api --filter @prensa-app/web --filter @prensa-app/worker dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
